# Builds the frontend once, then serves the static files with nginx.
FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.27-alpine
# The API address is read when the container starts (LMS_API_URL), so one image works in every environment.
ENV LMS_API_URL=http://localhost:8080/api
COPY nginx/default.conf.template /etc/lms/default.conf.template
COPY nginx/40-lms-config.sh /docker-entrypoint.d/40-lms-config.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-lms-config.sh && chmod +x /docker-entrypoint.d/40-lms-config.sh && rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
