APP_NAME="University LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# In containers, log to stderr as well so `podman logs` shows errors.
LOG_STACK=single,stderr
# Security events (logins, lockouts, denied access, password changes) go to their own JSON log; emails are hashed.
LOG_SECURITY_STACK=security_file,security_stderr
LOG_SECURITY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms
# The running app connects as a restricted role (lms_app: read/write rows, no schema changes, no admin rights). It is created
# automatically the first time the database container starts, with the password from LMS_APP_DB_PASSWORD in compose.yaml.
DB_USERNAME=lms_app
DB_PASSWORD=local-lms-app-password
# Migrations need to change tables, so they use the owner account: php artisan migrate --database=pgsql_migrate --force
DB_MIGRATE_USERNAME=lms
DB_MIGRATE_PASSWORD=local-lms-password
DB_CONNECT_TIMEOUT=5

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Defaults to true when APP_ENV=production. The API uses bearer tokens, not cookies.
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=localminio
AWS_SECRET_ACCESS_KEY=localminio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_CONNECT_TIMEOUT=5
AWS_REQUEST_TIMEOUT=60

SANCTUM_TOKEN_EXPIRATION=720
LMS_FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API (comma-separated). Defaults to the origin of LMS_FRONTEND_URL. Never "*".
LMS_CORS_ORIGINS=
# Addresses of your reverse proxy / load balancer ("*" only if the app is reachable solely through it), so client IPs, https,
# rate limits and lockouts see the real visitor instead of the proxy.
TRUSTED_PROXIES=
# Send Strict-Transport-Security even when TLS ends at the proxy (it is always sent for https requests).
LMS_FORCE_HSTS=false
# Sign-in lockout: this many wrong passwords for one email locks it for this many minutes.
LMS_LOCKOUT_ATTEMPTS=5
LMS_LOCKOUT_MINUTES=15
# Request-size and storage guards
LMS_JSON_BODY_KB=512
LMS_DAILY_UPLOAD_MB=200
# Public pages linked from the sign-in screen (returned by GET /api/auth/config)
LMS_PRIVACY_URL=
LMS_TERMS_URL=
LMS_UPLOAD_MIMES=pdf,doc,docx,ppt,pptx,xls,xlsx,odt,ods,odp,txt,md,csv,zip,png,jpg,jpeg,gif,mp3,mp4

# Grade appeals, check-in, summary emails, and message attachments
LMS_APPEAL_WINDOW_DAYS=14
LMS_CHECKIN_LATE_AFTER_MINUTES=10
LMS_DIGEST_DEFAULT=off
LMS_MESSAGE_MAX_ATTACHMENTS=5
LMS_MESSAGE_ATTACHMENT_KB=10240

# Virus scanning (start ClamAV with: podman compose --profile scan up -d)
LMS_VIRUS_SCAN=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
LMS_VIRUS_SCAN_FAIL_OPEN=false

# Single sign-on through OpenID Connect (see README)
LMS_SSO_ENABLED=false
LMS_SSO_LABEL="University sign-in"
LMS_SSO_ISSUER=
LMS_SSO_CLIENT_ID=
LMS_SSO_CLIENT_SECRET=
LMS_SSO_REDIRECT_URI=
LMS_SSO_AUTO_PROVISION=false
LMS_SSO_ALLOWED_DOMAINS=
LMS_SSO_REQUIRE_VERIFIED_EMAIL=true
LMS_SSO_PASSWORD_LOGIN=true
SENTRY_LARAVEL_DSN=
LMS_ADMIN_EMAIL=
LMS_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# ---- Institution, rules and administration -----------------------------------------------------------------------------
# Most of these can also be changed in the app (Administration > Settings); a value saved there wins over this file, and
# "Use the default" in the app goes back to what is written here.
LMS_INSTITUTION_NAME="University LMS"
LMS_INSTITUTION_SHORT_NAME=
LMS_SUPPORT_EMAIL=
LMS_SUPPORT_PHONE=
LMS_INSTITUTION_WEBSITE=
# The institution's time zone (dates are shown in it, reminders and the nightly jobs run in it) and date/number format.
LMS_TIMEZONE=UTC
LMS_LOCALE=en
# Password rules (12+ characters is the floor of what the app will accept from a user; these can only make it stricter).
LMS_PASSWORD_MIN_LENGTH=12
LMS_PASSWORD_MIXED_CASE=false
LMS_PASSWORD_NUMBER=false
LMS_PASSWORD_SYMBOL=false
# Largest course file or submission, in MB (never more than the server allows: LMS_SERVER_MAX_MB, default the PHP limit).
LMS_UPLOAD_MB=25
# LMS_SERVER_MAX_MB=
# Email and reminder behaviour
LMS_EMAIL_NOTIFICATIONS=true
LMS_DUE_REMINDERS=true
LMS_DUE_REMINDER_DAYS=1
# Housekeeping: how long low-value records are kept (grades, submissions and the audit log are never removed).
LMS_SECURITY_EVENT_DAYS=180
LMS_NOTIFICATION_DAYS=365
# Backups: nightly at 02:30 in the institution's time zone. Keep them on a different disk or machine from the app if you can.
LMS_BACKUPS=true
LMS_BACKUPS_KEEP=14
LMS_BACKUP_FILES=true
LMS_BACKUP_DISK=backups
# LMS_BACKUP_PATH=/var/backups/lms
# Maintenance mode (also a switch in Settings): only super administrators can use the system while it is on.
LMS_MAINTENANCE=false
LMS_MAINTENANCE_MESSAGE="The system is being maintained and will be back shortly."
# Shown on the system screen
LMS_VERSION=1.1.0
