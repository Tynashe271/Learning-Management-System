# Railway-specific image for the "api" service: the same PHP build as Containerfile, plus nginx in the same
# container (Railway runs one process group per service, unlike compose's separate app/nginx containers sharing a
# bind-mounted filesystem). The "queue" and "scheduler" Railway services reuse the plain Containerfile with a
# custom start command instead, since they never serve HTTP.
FROM docker.io/library/php:8.3-fpm-alpine
RUN apk add --no-cache icu-dev libzip-dev postgresql-dev nginx $PHPIZE_DEPS \
    && docker-php-ext-install intl pdo_pgsql zip pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN COMPOSER_PROCESS_TIMEOUT=1800 composer install --no-interaction --no-scripts --prefer-dist
COPY . .
RUN php artisan package:discover --ansi && chown -R www-data:www-data storage bootstrap/cache
COPY docker/railway-nginx.conf /etc/nginx/http.d/default.conf
COPY docker/railway-start.sh /start.sh
RUN rm -f /etc/nginx/conf.d/default.conf && chmod +x /start.sh
EXPOSE 8080
CMD ["/start.sh"]
